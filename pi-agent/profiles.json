{
  "strict": {
    "description": "Isolated standalone play with game interaction tools",
    "prompt": "standalone",
    "scale": 1,
    "observeAfterAction": true,
    "extensions": ["qunxia"],
    "tools": [
      "game_look",
      "game_press",
      "game_save",
      "game_load",
      "game_saves"
    ]
  },
  "benchmark": {
    "description": "Timed automation benchmark with the two game tools: look and press",
    "prompt": "session-help",
    "scale": 1,
    "observeAfterAction": false,
    "extensions": ["qunxia"],
    "tools": [
      "game_look",
      "game_press"
    ]
  },
  "benchmark-open-client": {
    "description": "Timed benchmark with local file, shell and CV work in a network-isolated container",
    "prompt": "session-help",
    "isolation": "container",
    "scale": 1,
    "observeAfterAction": false,
    "extensions": ["qunxia"],
    "tools": ["read", "write", "edit", "bash", "game_look", "game_press"]
  }
}
