.DS_Store
.build/
*.xcodeproj
DerivedData/
__pycache__/

# Keep extracted or locally modified game files out of the repository. The
# authorized distribution archive and its license note are the only game files
# tracked here; Scripts/pack-game.sh can rebuild the archive when necessary.
game/*
!game/JINYONG.zip
!game/README.md
assets/game-data.tar.gz

# Third-party sources, cloned separately (see README).
vendor/
ref-hojy/
ref-kys-pascal/
legacy-rewrite/

# Emulator snapshots.
saves/*.state

# Local pi harness state. auth.json holds API keys; models.json is generated
# from the QUNXIA_LLM_* env vars at launch. Only SYSTEM.md and extensions/ are
# part of the project.
pi-agent/*
!pi-agent/SYSTEM.md
!pi-agent/extensions/

# Scratch left in the repo root by agents playing the game: screenshots they
# captured and one-off scripts. Kept on disk, never committed.
/*.png
/*.py
