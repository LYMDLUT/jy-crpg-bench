.DS_Store
.build/
*.xcodeproj
DerivedData/
__pycache__/

# Game data is committed compressed as assets/game-data.tar.gz and unpacked
# here on first run.
game/

# Third-party sources, cloned separately (see README).
vendor/
ref-hojy/
ref-kys-pascal/
legacy-rewrite/

# Emulator snapshots.
saves/*.state

# Local pi harness state. auth.json holds API keys; models.json is generated
# from the QUNXIA_LLM_* env vars at launch. Only SYSTEM.md and extensions/ are
# part of the project.
pi-agent/*
!pi-agent/SYSTEM.md
!pi-agent/extensions/
